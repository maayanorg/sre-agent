{
    admin off
    http_port 8080
    https_port 8443
    servers {
        timeouts {
            read_header 10s
            read_body 15s
            write 45s
            idle 60s
        }
    }
}

{$SHOP_HOST} {
    header {
        Strict-Transport-Security "max-age=86400"
        X-Content-Type-Options nosniff
        Referrer-Policy no-referrer
        -Server
    }
    request_body {
        max_size 8KB
    }
    @shop {
        path / /api/shop/catalog /api/shop/media /api/shop/checkout /api/shop/orders/*
        method GET POST
    }
    handle @shop {
        reverse_proxy web.srelab.svc.cluster.local:80
    }
    handle {
        respond "Not found" 404
    }
}

http://:8082 {
    respond /healthz "ok" 200
}